# =============================================================
# AIHub — Environment Variables Reference
# =============================================================
# HOW TO USE:
#   cp .env.example .env
#   Fill in every value marked  <-- CHANGE THIS
#   Never commit the real .env file to version control.
# =============================================================


# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
APP_NAME="AIHub"
APP_ENV="development"           # development | staging | production
APP_VERSION="0.1.0"
GROQ_API_KEY=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
DEBUG=true                      # Set to false in production
SECRET_KEY="changeme-use-openssl-rand-hex-32-output"   # <-- CHANGE THIS
ALLOWED_ORIGINS="http://localhost:8501,http://localhost:3000"


# -------------------------------------------------------------
# DATABASE — PostgreSQL
# -------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="aihub"
POSTGRES_USER="aihub_user"
POSTGRES_PASSWORD="changeme"    # <-- CHANGE THIS
# Full DSN assembled by the app from the variables above.
# You can also set DATABASE_URL directly to override.
# DATABASE_URL="postgresql+asyncpg://aihub_user:changeme@localhost:5432/aihub"


# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""               # Leave blank if no auth (local dev)
REDIS_DB="0"
# REDIS_URL="redis://:password@localhost:6379/0"


# -------------------------------------------------------------
# JWT AUTHENTICATION
# -------------------------------------------------------------
JWT_SECRET_KEY="changeme-use-openssl-rand-hex-32-output"  # <-- CHANGE THIS
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"


# -------------------------------------------------------------
# AI — OpenAI / Compatible Provider
# -------------------------------------------------------------
OPENAI_API_KEY="sk-..."         # <-- CHANGE THIS
OPENAI_MODEL="gpt-4o-mini"      # Default chat model
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_MAX_TOKENS="2048"
OPENAI_TEMPERATURE="0.7"
# For Azure OpenAI or other compatible providers, set:
# OPENAI_API_BASE="https://your-resource.openai.azure.com/"
# OPENAI_API_VERSION="2024-02-15-preview"


# -------------------------------------------------------------
# VECTOR DATABASE
# -------------------------------------------------------------
# Options: "chroma" (local dev) | "pgvector" (production)
VECTOR_STORE_TYPE="chroma"

# ChromaDB (used when VECTOR_STORE_TYPE=chroma)
CHROMA_PERSIST_DIR="./data/chroma"

# pgvector (used when VECTOR_STORE_TYPE=pgvector)
# Reuses the same PostgreSQL instance by default.
# PGVECTOR_COLLECTION="aihub_embeddings"


# -------------------------------------------------------------
# FILE UPLOADS
# -------------------------------------------------------------
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB="20"
ALLOWED_EXTENSIONS="pdf,txt,md,docx,csv"


# -------------------------------------------------------------
# SUBSCRIPTION PLANS
# -------------------------------------------------------------
# Token limits per plan per month
FREE_PLAN_MONTHLY_TOKENS="50000"
PRO_PLAN_MONTHLY_TOKENS="500000"
ENTERPRISE_PLAN_MONTHLY_TOKENS="5000000"

# Request limits per plan per day
FREE_PLAN_DAILY_REQUESTS="20"
PRO_PLAN_DAILY_REQUESTS="500"
ENTERPRISE_PLAN_DAILY_REQUESTS="10000"


# -------------------------------------------------------------
# STRIPE (Payments — sandbox during development)
# -------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."          # <-- CHANGE THIS
STRIPE_PUBLISHABLE_KEY="pk_test_..."     # <-- CHANGE THIS
STRIPE_WEBHOOK_SECRET="whsec_..."        # <-- CHANGE THIS
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."


# -------------------------------------------------------------
# ADMIN
# -------------------------------------------------------------
ADMIN_EMAIL="admin@aihub.local"
ADMIN_PASSWORD="changeme"       # <-- CHANGE THIS — first run only


# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
LOG_LEVEL="INFO"                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"               # json | text
LOG_FILE="./logs/aihub.log"     # Leave blank to log to stdout only


# -------------------------------------------------------------
# CORS / FRONTEND
# -------------------------------------------------------------
FRONTEND_URL="http://localhost:8501"
BACKEND_URL="http://localhost:8000"
