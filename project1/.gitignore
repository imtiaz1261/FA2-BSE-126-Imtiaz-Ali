# =============================================================
# AIHub — .gitignore
# =============================================================

# ----- Secrets & Environment --------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST
.Python

# ----- Virtual Environments ---------------------------------
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ----- Testing ----------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml
test-results/

# ----- Type Checking ----------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ----- IDEs & Editors ---------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Docker -----------------------------------------------
*.dockerignore

# ----- Data & Uploads ---------------------------------------
data/
logs/
*.log

# ----- Alembic ----------------------------------------------
# Keep migrations but ignore compiled artifacts
backend/migrations/versions/__pycache__/

# ----- ChromaDB local state ---------------------------------
chroma/
*.chroma

# ----- Node (if any frontend tooling is added later) --------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Jupyter (for any notebook experiments) ---------------
.ipynb_checkpoints
*.ipynb

# ----- Misc -------------------------------------------------
*.bak
*.tmp
*.temp
.cache/
