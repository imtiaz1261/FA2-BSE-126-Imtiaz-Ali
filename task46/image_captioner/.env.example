# Which provider to use: "groq" (free) or "openai" (paid)
LLM_PROVIDER=groq

# Get a FREE key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=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

# Only needed if you set LLM_PROVIDER=openai
OPENAI_API_KEY=

# Vision-capable model. As of this writing, Groq's only vision model is
# qwen/qwen3.6-27b (Groq deprecates/renames vision models periodically —
# check https://console.groq.com/docs/vision if this stops working).
VISION_MODEL_NAME=qwen/qwen3.6-27b
