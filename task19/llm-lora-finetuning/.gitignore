# Python
__pycache__/
*.pyc
.venv/
venv/

# Model checkpoints and fine-tuned weights are large binary files —
# never commit them to git. Document how to regenerate them instead.
models/fine_tuned/*
!models/fine_tuned/.gitkeep

# Training logs / TensorBoard event files
logs/*
!logs/.gitkeep

# Dataset files can be large or contain licensed content — track the
# scripts that generate/prepare them, not the raw data itself, by
# default. The one exception below is our own small, hand-authored
# dataset, which is worth keeping in version control.
data/*
!data/.gitkeep
!data/novatech_support.jsonl

# The processed/tokenized dataset is regenerated by running
# prepare_dataset.py, so it doesn't need to be committed.
data/processed/
