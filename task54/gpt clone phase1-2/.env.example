# ============================================================================
# Application Configuration
# ============================================================================

APP_NAME=Chatline
ENVIRONMENT=production
FRONTEND_URL=https://chatline.example.com
IS_PRODUCTION=true
LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================

# Primary async database (used by FastAPI)
DATABASE_URL=postgresql+asyncpg://username:password@postgres.example.com:5432/chatline

# Sync database URL (used for Alembic migrations and admin tasks)
DATABASE_URL_SYNC=postgresql+psycopg2://username:password@postgres.example.com:5432/chatline

# Database connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_URL=redis://:password@redis.example.com:6379/0

# ============================================================================
# Authentication & JWT
# ============================================================================

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-change-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie configuration
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=.chatline.example.com
COOKIE_SAME_SITE=lax

# ============================================================================
# OAuth Configuration
# ============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# Object Storage (S3 / MinIO / R2)
# ============================================================================

# S3 Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
S3_BUCKET=chatline-documents

# For MinIO/R2/local development:
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=chatline

# ============================================================================
# Stripe Billing Configuration
# ============================================================================

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Price IDs
STRIPE_PLUS_PRICE_ID=price_plus_id
STRIPE_PRO_PRICE_ID=price_pro_id

# ============================================================================
# Usage Limits & Plans
# ============================================================================

FREE_DAILY_MESSAGES=20
PLUS_DAILY_MESSAGES=300
PRO_DAILY_MESSAGES=1000

# ============================================================================
# Memory & Personalization
# ============================================================================

MEMORY_ENABLED=true
MEMORY_EXTRACTION_MODEL=gpt-4-turbo
MEMORY_EXTRACTION_TEMPERATURE=0.3
MEMORY_RETENTION_DAYS=365
MEMORY_MAX_ITEMS=1000
MEMORY_CONTEXT_INJECTION_COUNT=5
MEMORY_RETRIEVAL_THRESHOLD=0.5

# ============================================================================
# Embeddings Configuration
# ============================================================================

EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSION=1536

# ============================================================================
# Rate Limiting
# ============================================================================

LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=100/minute

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001

# ============================================================================
# Email Configuration (for password resets, notifications)
# ============================================================================

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@chatline.example.com
SMTP_USE_TLS=true

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_RAG=true
ENABLE_AGENTS=true
ENABLE_MEMORY=true

# ============================================================================
# Worker Configuration
# ============================================================================

# Background job processing
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=300

# Document processing
MAX_DOCUMENT_SIZE_MB=100
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# ============================================================================
# Agent Sandbox Configuration
# ============================================================================

# Sandbox execution limits
AGENT_TIMEOUT_SECONDS=30
AGENT_MEMORY_LIMIT_MB=512
AGENT_CPU_LIMIT=1

# ============================================================================
# Development/Testing Only
# ============================================================================

# Skip SSL verification (development only)
# SKIP_SSL_VERIFY=false

# Enable debug mode (development only)
# DEBUG=false

# Mock services (testing only)
# MOCK_OPENAI=false
# MOCK_STRIPE=false
