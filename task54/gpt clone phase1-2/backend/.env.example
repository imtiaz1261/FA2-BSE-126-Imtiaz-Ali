# ---- App ------------------------------------------------------------------
APP_NAME="Chatline"
ENVIRONMENT=development                 # development | production
FRONTEND_URL=http://localhost:5173      # used to build email links + CORS + OAuth redirect

# ---- Database ---------------------------------------------------------------
# Async URL used by the app; sync URL used by Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:imtiaz123@localhost:5432/chatline
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:imtiaz123@localhost:5432/chatline

# ---- JWT / sessions ---------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=f/N3&rNz]#;/(!*[mp]i5i
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cookies ------------------------------------------------------------------
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ---- Rate limiting ------------------------------------------------------------
LOGIN_RATE_LIMIT="5/minute"

# ---- Email (SMTP) ---------------------------------------------------------
# Used for verification + password-reset emails. In development, if SMTP_HOST
# is left blank the app logs the email content + link to the console instead
# of sending, so you can develop without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chatline.app

# ---- OAuth: Google ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth: GitHub ----------------------------------------------------------
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth: Microsoft ---------------------------------------------------------
# https://portal.azure.com -> App registrations
# MICROSOFT_TENANT: "common" allows both personal Microsoft accounts and
# work/school accounts; use a specific tenant ID to restrict to one org.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common


# ---- Redis (for usage tracking & caching) ---------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Stripe: Billing & Subscriptions -----------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription plans
# Create prices in Stripe dashboard and paste IDs here
STRIPE_PLUS_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ---- Plan Limits: Daily Messages per Plan -------------------------------
# Daily message allowances for each subscription tier
FREE_DAILY_MESSAGES=20
PLUS_DAILY_MESSAGES=300
PRO_DAILY_MESSAGES=1000

# ---- Memory & Personalization -------------------------------------------
# Enable/disable long-term memory system
MEMORY_ENABLED=true

# Memory extraction LLM settings
MEMORY_EXTRACTION_MODEL=gpt-4
MEMORY_EXTRACTION_TEMPERATURE=0.3

# Memory retention (days; 0 = keep forever)
MEMORY_RETENTION_DAYS=365

# Memory store settings
MEMORY_MAX_ITEMS=1000
MEMORY_CONTEXT_INJECTION_COUNT=5
MEMORY_RETRIEVAL_THRESHOLD=0.5

# Embeddings model for semantic retrieval (optional; uses OpenAI by default)
EMBEDDINGS_MODEL=text-embedding-3-small

