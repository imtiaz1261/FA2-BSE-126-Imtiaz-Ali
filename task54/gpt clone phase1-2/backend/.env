# ---- App ------------------------------------------------------------------
APP_NAME="Chatline"
ENVIRONMENT=development                 # development | production
FRONTEND_URL=http://localhost:5173

# ---- Database ---------------------------------------------------------------
# Async URL used by the app; sync URL used by Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:imtiaz123@localhost:5432/chatline
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:imtiaz123@localhost:5432/chatline

# ---- JWT / sessions ---------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=f/N3&rNz]#;/(!*[mp]i5i
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cookies ------------------------------------------------------------------
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ---- Rate limiting ------------------------------------------------------------
LOGIN_RATE_LIMIT="5/minute"

# ---- Email (SMTP) ---------------------------------------------------------
# Used for verification + password-reset emails. In development, if SMTP_HOST
# is left blank the app logs the email content + link to the console instead
# of sending, so you can develop without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chatline.app

# ---- OAuth: Google ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth: GitHub ----------------------------------------------------------
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth: Microsoft ---------------------------------------------------------
# https://portal.azure.com -> App registrations
# MICROSOFT_TENANT: "common" allows both personal Microsoft accounts and
# work/school accounts; use a specific tenant ID to restrict to one org.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
