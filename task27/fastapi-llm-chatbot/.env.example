# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.

# --- General ---
APP_NAME=LLM Chatbot
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- LLM provider ---
# Supported values: groq | openai
LLM_PROVIDER=groq
# Leave blank to use a sensible default per provider
# (groq -> llama-3.1-8b-instant, openai -> gpt-4o-mini)
LLM_MODEL=

# Only ONE of these is required, matching LLM_PROVIDER above.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY = your-openai-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

LLM_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Security ---
# Comma-separated list of allowed origins, or * for all (not recommended in production)
CORS_ALLOW_ORIGINS=*
MAX_MESSAGE_LENGTH=4000
