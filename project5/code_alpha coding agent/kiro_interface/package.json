{
  "name": "code-alpha-kiro-interface",
  "displayName": "Code Alpha - Kiro-Style Interface",
  "description": "VS Code extension for autonomous coding with Code Alpha - Kiro-like interface",
  "version": "1.0.0",
  "publisher": "codealpha",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "codeAlpha.newTask",
        "title": "Code Alpha: New Task",
        "icon": "$(add)"
      },
      {
        "command": "codeAlpha.runTask",
        "title": "Code Alpha: Run Task",
        "icon": "$(play)"
      },
      {
        "command": "codeAlpha.pauseTask",
        "title": "Code Alpha: Pause Task",
        "icon": "$(debug-pause)"
      },
      {
        "command": "codeAlpha.stopTask",
        "title": "Code Alpha: Stop Task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeAlpha.reviewChanges",
        "title": "Code Alpha: Review Changes",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "codeAlpha.approveChanges",
        "title": "Code Alpha: Approve Changes",
        "icon": "$(check)"
      },
      {
        "command": "codeAlpha.rejectChanges",
        "title": "Code Alpha: Reject Changes",
        "icon": "$(close)"
      },
      {
        "command": "codeAlpha.showHistory",
        "title": "Code Alpha: Show History",
        "icon": "$(history)"
      },
      {
        "command": "codeAlpha.openSettings",
        "title": "Code Alpha: Open Settings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeAlphaSidebar",
          "title": "Code Alpha",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "codeAlphaSidebar": [
        {
          "id": "codeAlphaTaskInput",
          "name": "New Task",
          "type": "webview"
        },
        {
          "id": "codeAlphaActiveTasks",
          "name": "Active Tasks"
        },
        {
          "id": "codeAlphaChanges",
          "name": "Pending Changes"
        },
        {
          "id": "codeAlphaHistory",
          "name": "History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeAlpha.newTask",
          "group": "navigation",
          "when": "view == codeAlphaTaskInput"
        }
      ],
      "editor/title": [
        {
          "command": "codeAlpha.runTask",
          "group": "navigation",
          "when": "editorTextFocus && codeAlpha.hasActiveTask"
        }
      ]
    },
    "configuration": {
      "title": "Code Alpha",
      "properties": {
        "codeAlpha.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Code Alpha server URL"
        },
        "codeAlpha.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve changes"
        },
        "codeAlpha.safetyMode": {
          "type": "string",
          "enum": ["permissive", "standard", "strict", "emergency"],
          "default": "standard",
          "description": "Safety mode for operations"
        },
        "codeAlpha.maxFilesPerTask": {
          "type": "number",
          "default": 50,
          "description": "Maximum files that can be modified per task"
        },
        "codeAlpha.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for task events"
        }
      }
    },
    "keybindings": [
      {
        "command": "codeAlpha.newTask",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "codeAlpha.runTask",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter"
      },
      {
        "command": "codeAlpha.reviewChanges",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.1.0",
    "esbuild": "^0.18.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node16",
    "package": "vsce package"
  }
}
