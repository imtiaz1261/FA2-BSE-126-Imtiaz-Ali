import * as vscode from 'vscode';
import * as path from 'path';
import * as fs from 'fs';

let currentPanel: vscode.WebviewPanel | undefined;

export function activate(context: vscode.ExtensionContext) {
    console.log('Code Alpha Kiro Extension activated!');

    // Command to open the Kiro interface - MUST match package.json
    const disposable = vscode.commands.registerCommand(
        'codeAlpha.newTask',
        () => {
            openKiroInterface(context);
        }
    );

    context.subscriptions.push(disposable);

    // Also register direct interface command
    const interfaceCommand = vscode.commands.registerCommand(
        'kiro.openInterface',
        () => {
            openKiroInterface(context);
        }
    );
    context.subscriptions.push(interfaceCommand);

    // Show info message
    vscode.window.showInformationMessage('✨ Code Alpha Kiro loaded! Press Ctrl+Shift+K or use Command Palette to open');
}

function openKiroInterface(context: vscode.ExtensionContext) {
    // If panel already exists, show it
    if (currentPanel) {
        currentPanel.reveal(vscode.ViewColumn.Two);
        return;
    }

    // Create new webview panel
    currentPanel = vscode.window.createWebviewPanel(
        'kiroInterface',
        '⚡ Code Alpha - Kiro Interface',
        vscode.ViewColumn.Two,
        {
            enableScripts: true,
            enableForms: true,
            retainContextWhenHidden: true,
            localResourceRoots: [
                vscode.Uri.file(path.join(context.extensionPath, 'src'))
            ]
        }
    );

    // Set webview HTML
    currentPanel.webview.html = getWebviewContent(context);

    // Handle panel closed
    currentPanel.onDidDispose(
        () => {
            currentPanel = undefined;
        },
        null,
        context.subscriptions
    );

    // Handle messages from webview
    currentPanel.webview.onDidReceiveMessage(
        async (message) => {
            handleWebviewMessage(message, context);
        },
        null,
        context.subscriptions
    );
}

function getWebviewContent(context: vscode.ExtensionContext): string {
    // Read the webview HTML file
    const webviewPath = path.join(context.extensionPath, 'src', 'webview.html');
    
    try {
        let html = fs.readFileSync(webviewPath, 'utf8');
        return html;
    } catch (error) {
        // Fallback if file doesn't exist
        return getDefaultWebviewContent();
    }
}

function getDefaultWebviewContent(): string {
    return `
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code Alpha - Kiro</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0e27;
            color: #e0e0e0;
            overflow: hidden;
        }

        .container {
            display: flex;
            height: 100vh;
            gap: 1px;
        }

        .canvas-section {
            flex: 1;
            position: relative;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
            border-right: 1px solid rgba(100, 200, 255, 0.2);
        }

        #canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .status-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            padding: 10px 20px;
            background: rgba(30, 144, 255, 0.9);
            border: 2px solid #00ffff;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
            animation: pulse 2s infinite;
        }

        .status-badge.complete {
            background: rgba(34, 197, 94, 0.9);
            border-color: #00ff00;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.5);
        }

        .status-badge.error {
            background: rgba(239, 68, 68, 0.9);
            border-color: #ff0000;
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.5);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        .control-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #0d1117;
            border-left: 1px solid rgba(100, 200, 255, 0.2);
        }

        .panel-header {
            padding: 20px;
            border-bottom: 1px solid rgba(100, 200, 255, 0.1);
            background: linear-gradient(180deg, #1a1f3a 0%, #0d1117 100%);
        }

        .panel-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 1px;
        }

        .panel-subtitle {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .input-section {
            padding: 20px;
            border-bottom: 1px solid rgba(100, 200, 255, 0.1);
        }

        .input-label {
            font-size: 12px;
            color: #00ffff;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
            display: block;
            font-weight: 600;
        }

        .task-input {
            width: 100%;
            padding: 12px;
            background: rgba(20, 30, 60, 0.8);
            border: 2px solid rgba(100, 200, 255, 0.3);
            color: #e0e0e0;
            border-radius: 8px;
            font-size: 13px;
            font-family: 'Courier New', monospace;
            transition: all 0.3s ease;
            resize: vertical;
            min-height: 80px;
            margin-bottom: 10px;
        }

        .task-input:focus {
            outline: none;
            border-color: #00ffff;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
        }

        .button-group {
            display: flex;
            gap: 10px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            border: 2px solid #00ffff;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            background: transparent;
            color: #00ffff;
            transition: all 0.3s ease;
        }

        .btn:hover {
            background: rgba(0, 255, 255, 0.2);
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
            transform: translateY(-2px);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .output-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-bottom: 1px solid rgba(100, 200, 255, 0.1);
        }

        .output-header {
            padding: 12px 20px;
            background: rgba(0, 255, 255, 0.1);
            border-bottom: 1px solid rgba(100, 200, 255, 0.2);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: #00ffff;
        }

        .output-tabs {
            display: flex;
            border-bottom: 1px solid rgba(100, 200, 255, 0.1);
            padding: 0 20px;
            background: rgba(0, 0, 0, 0.3);
        }

        .output-tab {
            padding: 10px 15px;
            border: none;
            background: transparent;
            color: #888;
            cursor: pointer;
            font-size: 12px;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

        .output-tab.active {
            color: #00ffff;
            border-bottom-color: #00ffff;
        }

        .output-content {
            flex: 1;
            overflow-y: auto;
            padding: 15px 20px;
            font-size: 12px;
            font-family: 'Courier New', monospace;
        }

        .log-entry {
            margin: 4px 0;
            padding: 5px 8px;
            background: rgba(255, 255, 255, 0.05);
            border-left: 2px solid #666;
        }

        .log-entry.info {
            border-left-color: #00ffff;
            color: #00ffff;
        }

        .log-entry.success {
            border-left-color: #00ff00;
            color: #00ff00;
        }

        .log-entry.error {
            border-left-color: #ff0000;
            color: #ff4444;
        }

        .code-display {
            background: rgba(10, 14, 39, 0.8);
            border: 1px solid rgba(100, 200, 255, 0.2);
            border-radius: 6px;
            padding: 15px;
            overflow-x: auto;
            font-size: 11px;
            line-height: 1.5;
        }

        .progress-bar {
            height: 3px;
            background: rgba(100, 200, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
            margin: 10px 0;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #00ffff, #ff00ff);
            width: 0%;
            transition: width 0.3s ease;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 255, 0.3);
            border-radius: 3px;
        }

        .spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid rgba(0, 255, 255, 0.3);
            border-top-color: #00ffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="canvas-section">
            <canvas id="canvas"></canvas>
            <div class="status-badge" id="statusBadge">
                <span class="spinner"></span> INITIALIZING
            </div>
        </div>

        <div class="control-panel">
            <div class="panel-header">
                <div class="panel-title">⚡ CODE ALPHA</div>
                <div class="panel-subtitle">Autonomous Code Generation</div>
            </div>

            <div class="input-section">
                <label class="input-label">📝 Task</label>
                <textarea class="task-input" id="taskInput" placeholder="Example: Create a fibonacci function"></textarea>
                <div class="button-group">
                    <button class="btn" id="submitBtn">▶ EXECUTE</button>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
            </div>

            <div class="output-section">
                <div class="output-header">📊 OUTPUT</div>
                <div class="output-tabs">
                    <button class="output-tab active" data-tab="logs">Logs</button>
                    <button class="output-tab" data-tab="code">Code</button>
                </div>
                <div class="output-content">
                    <div id="logsPanel" class="tab-panel active">
                        <div class="log-entry info">Ready for task submission...</div>
                    </div>
                    <div id="codePanel" class="tab-panel" style="display:none;">
                        <div class="code-display" id="codeDisplay">// Generated code will appear here</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 3D Canvas
        let scene, camera, renderer;

        function initThreeJS() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0e27);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / 2 / window.innerHeight, 0.1, 1000);
            camera.position.z = 30;

            const canvas = document.getElementById('canvas');
            renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setSize(window.innerWidth / 2, window.innerHeight);

            // Create particles
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(200 * 3);
            for (let i = 0; i < 200 * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 100;
                positions[i + 1] = (Math.random() - 0.5) * 100;
                positions[i + 2] = (Math.random() - 0.5) * 100;
            }
            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

            const material = new THREE.PointsMaterial({
                color: 0x00ffff,
                size: 0.5,
                transparent: true,
                opacity: 0.6
            });

            const points = new THREE.Points(geometry, material);
            scene.add(points);

            // Grid
            const grid = new THREE.GridHelper(100, 20, 0x00ffff, 0x0a0e27);
            grid.position.y = -20;
            scene.add(grid);

            animate();
        }

        function animate() {
            requestAnimationFrame(animate);
            camera.position.x = Math.cos(Date.now() * 0.0001) * 30;
            camera.position.z = Math.sin(Date.now() * 0.0001) * 30;
            camera.lookAt(0, 0, 0);
            renderer.render(scene, camera);
        }

        // UI Logic
        const taskInput = document.getElementById('taskInput');
        const submitBtn = document.getElementById('submitBtn');
        const statusBadge = document.getElementById('statusBadge');
        const progressFill = document.getElementById('progressFill');
        const logsPanel = document.getElementById('logsPanel');
        const codePanel = document.getElementById('codePanel');
        const codeDisplay = document.getElementById('codeDisplay');

        document.querySelectorAll('.output-tab').forEach(tab => {
            tab.addEventListener('click', (e) => {
                document.querySelectorAll('.output-tab').forEach(t => t.classList.remove('active'));
                e.target.classList.add('active');
                document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
                document.getElementById(e.target.dataset.tab + 'Panel').style.display = 'block';
            });
        });

        submitBtn.addEventListener('click', async () => {
            const prompt = taskInput.value.trim();
            if (!prompt) {
                addLog('Enter a task description', 'error');
                return;
            }

            submitBtn.disabled = true;
            logsPanel.innerHTML = '';
            statusBadge.textContent = '⏳ PROCESSING';

            try {
                const res = await fetch('http://localhost:8000/tasks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt, repo_path: '.' })
                });

                const task = await res.json();
                addLog(\`Task ID: \${task.task_id}\`, 'success');

                // Stream events
                const stream = await fetch(\`http://localhost:8000/tasks/\${task.task_id}/stream\`);
                const reader = stream.body.getReader();
                const decoder = new TextDecoder();

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    const text = decoder.decode(value);
                    text.split('\\n').forEach(line => {
                        if (line.startsWith('data: ')) {
                            const event = JSON.parse(line.slice(6));
                            if (event.event === 'log') addLog(event.data, 'info');
                            if (event.event === 'progress') progressFill.style.width = event.data + '%';
                            if (event.event === 'code') {
                                codeDisplay.textContent = event.data;
                                hljs.highlightElement(codeDisplay);
                            }
                            if (event.event === 'complete') {
                                statusBadge.textContent = '✅ COMPLETE';
                                statusBadge.classList.add('complete');
                            }
                        }
                    });
                }
            } catch (error) {
                addLog(\`Error: \${error.message}\`, 'error');
            } finally {
                submitBtn.disabled = false;
            }
        });

        function addLog(msg, type) {
            const entry = document.createElement('div');
            entry.className = \`log-entry \${type}\`;
            entry.textContent = msg;
            logsPanel.appendChild(entry);
            logsPanel.scrollTop = logsPanel.scrollHeight;
        }

        window.addEventListener('DOMContentLoaded', initThreeJS);
        initThreeJS();
    </script>
</body>
</html>
    `;
}

async function handleWebviewMessage(message: any, context: vscode.ExtensionContext) {
    switch (message.command) {
        case 'alert':
            vscode.window.showInformationMessage(message.text);
            break;
    }
}

export function deactivate() {
    if (currentPanel) {
        currentPanel.dispose();
    }
}
