// Jenkins Pipeline for Code Alpha

pipeline {
    agent any
    
    environment {
        PYTHON_VERSION = '3.10'
        CODE_ALPHA_PROMPT = 'Improve code quality and add comprehensive tests'
        VENV_DIR = '.venv'
    }
    
    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    stages {
        stage('Setup') {
            steps {
                script {
                    echo '🔧 Setting up environment...'
                    sh '''
                        python3 -m venv ${VENV_DIR}
                        source ${VENV_DIR}/bin/activate
                        pip install --upgrade pip
                        pip install -e .
                        pip install typer rich pydantic fastapi uvicorn
                    '''
                }
            }
        }
        
        stage('Code Alpha - Generate') {
            steps {
                script {
                    echo '🤖 Running Code Alpha...'
                    sh '''
                        source ${VENV_DIR}/bin/activate
                        codealpha run "${CODE_ALPHA_PROMPT}" \
                            --repo . \
                            --auto-approve-low-risk \
                            --max-retries 3 \
                            --json > result.json
                    '''
                }
            }
        }
        
        stage('Results Processing') {
            steps {
                script {
                    echo '📊 Processing results...'
                    sh '''
                        source ${VENV_DIR}/bin/activate
                        python3 << 'EOF'
import json

with open('result.json') as f:
    result = json.load(f)

print("\n=== Code Alpha Results ===")
print(f"Status: {result['status']}")
print(f"Files Changed: {result['metrics']['total_edits']}")
print(f"Tests Passed: {result['metrics']['passing_tests']}/{result['metrics']['total_tests']}")
print(f"Duration: {result['duration_seconds']:.1f}s")
print(f"Lines Changed: {result['metrics']['total_lines_changed']}")

# Archive results
with open('jenkins-report.json', 'w') as f:
    json.dump(result, f, indent=2)

# Create summary
summary = f"""
Code Alpha Report:
- Status: {result['status']}
- Files: {result['metrics']['total_edits']}
- Tests: {result['metrics']['passing_tests']}/{result['metrics']['total_tests']}
- Duration: {result['duration_seconds']:.1f}s
"""

with open('BUILD_SUMMARY.txt', 'w') as f:
    f.write(summary)
EOF
                    '''
                }
            }
        }
        
        stage('Create Pull Request') {
            when {
                expression {
                    return fileExists('result.json')
                }
            }
            steps {
                script {
                    echo '📝 Creating pull request...'
                    sh '''
                        source ${VENV_DIR}/bin/activate
                        python3 << 'EOF'
import json
import subprocess
import os

with open('result.json') as f:
    result = json.load(f)

if result['status'] == 'completed':
    # Create branch
    branch_name = f"code-alpha-improvements-{os.environ['BUILD_NUMBER']}"
    
    subprocess.run(['git', 'config', 'user.email', 'ci@jenkins.local'], check=True)
    subprocess.run(['git', 'config', 'user.name', 'Jenkins CI'], check=True)
    
    # Check if there are changes
    status = subprocess.run(['git', 'status', '--short'], capture_output=True, text=True)
    
    if status.stdout.strip():
        subprocess.run(['git', 'checkout', '-b', branch_name], check=True)
        subprocess.run(['git', 'add', '-A'], check=True)
        subprocess.run(['git', 'commit', '-m', f'chore: Code Alpha improvements (Build #{os.environ["BUILD_NUMBER"]})'], check=True)
        subprocess.run(['git', 'push', '-u', 'origin', branch_name], check=True)
        
        print(f"✅ Created branch: {branch_name}")
else:
    print("❌ Code Alpha failed, skipping PR creation")
EOF
                    '''
                }
            }
        }
        
        stage('Cleanup') {
            steps {
                cleanWs(deleteDirs: true, patterns: [[pattern: '.venv', type: 'INCLUDE']])
            }
        }
    }
    
    post {
        always {
            // Archive artifacts
            archiveArtifacts artifacts: 'result.json,jenkins-report.json', 
                            allowEmptyArchive: true
            
            // Publish build summary
            script {
                if (fileExists('BUILD_SUMMARY.txt')) {
                    def summary = readFile('BUILD_SUMMARY.txt')
                    currentBuild.description = summary
                }
            }
        }
        
        success {
            echo '✅ Build completed successfully'
        }
        
        failure {
            echo '❌ Build failed'
        }
        
        unstable {
            echo '⚠️ Build is unstable'
        }
    }
}
