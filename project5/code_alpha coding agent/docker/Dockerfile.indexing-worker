# Dockerfile for Code Alpha Indexing Worker Service

FROM python:3.10-slim

LABEL maintainer="Code Alpha"
LABEL description="Code Alpha Indexing Worker - Context indexing and embedding generation"
LABEL version="1.0.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /app/

# Install Python dependencies (including embedding libraries)
RUN pip install --upgrade pip && \
    pip install -e . && \
    pip install -r requirements_cli_api.txt && \
    pip install sentence-transformers scikit-learn

# Create non-root user
RUN useradd -m -u 1000 codealpha && \
    chown -R codealpha:codealpha /app

# Create directories
RUN mkdir -p /app/logs /app/vectors /app/.codealpha && \
    chown -R codealpha:codealpha /app/logs /app/vectors /app/.codealpha

USER codealpha

# Expose worker port
EXPOSE 8003

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SERVICE_TYPE=indexing_worker
ENV LOG_LEVEL=INFO
ENV VECTOR_STORE_PATH=/app/vectors

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# Indexing worker entrypoint
CMD ["python", "-m", "code_alpha.context.engine", \
     "--host", "0.0.0.0", \
     "--port", "8003", \
     "--workers", "2"]

