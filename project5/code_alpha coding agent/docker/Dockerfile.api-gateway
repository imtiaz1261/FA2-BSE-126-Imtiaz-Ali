# Dockerfile for Code Alpha API Gateway Service

FROM python:3.10-slim

LABEL maintainer="Code Alpha"
LABEL description="Code Alpha API Gateway - REST API entry point and load balancer"
LABEL version="1.0.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /app/

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install -e . && \
    pip install -r requirements_cli_api.txt && \
    pip install fastapi uvicorn pydantic

# Create non-root user
RUN useradd -m -u 1000 codealpha && \
    chown -R codealpha:codealpha /app

# Create directories
RUN mkdir -p /app/logs /app/.codealpha && \
    chown -R codealpha:codealpha /app/logs /app/.codealpha

USER codealpha

# Expose API port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SERVICE_TYPE=api_gateway
ENV LOG_LEVEL=INFO

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# API Gateway entrypoint
CMD ["python", "-m", "uvicorn", \
     "code_alpha.apis.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4"]

# Build:
# docker build -f docker/Dockerfile.api-gateway -t codealpha-api:latest .

# Run:
# docker run -p 8000:8000 \
#   -v $(pwd):/workspace \
#   -e ORCHESTRATOR_URL=http://orchestrator:8001 \
#   -e REDIS_URL=redis://redis:6379 \
#   codealpha-api:latest
