# ---------------------------------------------------------------
# Embeddings — gemini-embedding-001 via the Gemini API (free tier,
# no credit card needed). Falls back to huggingface if unset.
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6LfAX6SoKczcrwyNSExdi-_2UwLTCQzsHQ9TLkHKVDQoA
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------
# LLM — used for the final answer generation step. Using Gemini
# Flash so it shares the same API key as embeddings and voice.
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------
# Voice — speech-to-text (audio sent as multimodal input to a
# Gemini Flash model) and text-to-speech (native audio-out model).
# Same GEMINI_API_KEY above covers both.
# ---------------------------------------------------------------
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash
TTS_PROVIDER=gemini
TTS_MODEL=gemini-2.5-flash-preview-tts

# ---------------------------------------------------------------
# Vector store — chroma is the primary backend; faiss is optional.
# ---------------------------------------------------------------
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PATH=data/vector_db
COLLECTION_NAME=jarvis_lite_docs

# ---------------------------------------------------------------
# Chunking / retrieval
# ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4

# ---------------------------------------------------------------
# Storage / logging
# ---------------------------------------------------------------
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO