# Which provider to use: "groq" (free) or "openai" (paid)
LLM_PROVIDER=groq

# Get a FREE Groq key at: https://console.groq.com/keys
# (no credit card required, generous free rate limits)
GROQ_API_KEY=paste key

# Optional — only needed if you switch to OpenAI
OPENAI_API_KEY = "sk-your-openai-key-here" use the api key and give me the single updated file
# Model to use. Good free Groq defaults: llama-3.1-8b-instant, llama-3.1-70b-versatile
MODEL_NAME=llama-3.1-8b-instant
