# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
LLM_MODEL=gpt-3.5-turbo

# Entity Extraction
NER_MODEL=en_core_web_sm
MIN_CONFIDENCE_SCORE=0.7

# Graph RAG Settings
MAX_HOPS=3
CONTEXT_WINDOW=2000