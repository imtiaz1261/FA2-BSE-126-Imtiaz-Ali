# Copy this file to .env and edit as needed.
# All variables are optional — sane defaults are used if unset.

# ---------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------
# Provider: sentence_transformers (default, local model) | openai | local_tfidf (offline fallback)
EMBEDDING_PROVIDER=sentence_transformers

# Model name — depends on the provider above.
# sentence_transformers examples: all-MiniLM-L6-v2 (default, fast) | all-mpnet-base-v2 (higher quality)
# openai examples: text-embedding-3-small | text-embedding-3-large
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Required only if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Batch size used when embedding documents during indexing
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------
# Provider: chroma (default, local & persistent) | pinecone (managed cloud) | memory (dev/test only)
VECTOR_DB_PROVIDER=chroma

# Name of the collection / index
COLLECTION_NAME=jarvis_knowledge_base

# ChromaDB: local folder where the persistent index is stored
CHROMA_PERSIST_DIR=./chroma_db

# Pinecone (required only if VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=jarvis-knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------
# Search behaviour
# ---------------------------------------------------------------
TOP_K=5
MIN_SCORE=0.0

# ---------------------------------------------------------------
# Document processing
# ---------------------------------------------------------------
DOCUMENTS_DIR=./data/documents
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
LOG_LEVEL=INFO
