# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file.

PORT=9500
DATABASE_URL=postgresql://status_service_user:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/appointments

BOOKING_SERVICE_BASE_URL=http://localhost:7000
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8000
TRACKING_SERVICE_BASE_URL=http://localhost:8500

TWILIO_ACCOUNT_SID=REPLACE_WITH_YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_AUTH_TOKEN
