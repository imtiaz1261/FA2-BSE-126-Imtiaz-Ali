# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file, and never hardcode credentials directly in source — this file
# is a template with placeholders only.

PORT=6000
DATABASE_URL=postgresql://slot_engine_user:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/appointments
REDIS_URL=redis://localhost:6379

HOLD_TTL_SECONDS=120
HOLD_SWEEP_INTERVAL_MS=15000

DEFAULT_DAY_START=09:00
DEFAULT_DAY_END=17:00
DEFAULT_BLOCK_MINUTES=30
DEFAULT_CAPACITY_PER_BLOCK=4

NEAREST_SEARCH_DAYS=3
NEAREST_RESULTS_LIMIT=5
