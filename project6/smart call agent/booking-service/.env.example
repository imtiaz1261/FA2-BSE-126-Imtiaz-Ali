# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file. DATABASE_URL should point at the SAME Postgres instance/schema
# used by slot-engine (see README: "Why this service touches the slots
# tables directly").

PORT=7000
DATABASE_URL=postgresql://booking_service_user:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/appointments

SLOT_ENGINE_BASE_URL=http://localhost:6000
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8000
