# Single .env file for the whole project (backend + frontend).
# Copy this file to .env at the project root and fill in real values.
# Never commit .env — it's already in .gitignore.

# --- General ---
APP_NAME=AI Research & Knowledge Workspace
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# --- Frontend ---
API_BASE_URL=http://localhost:8000/api
APP_TITLE=AI Research & Knowledge Workspace

# --- Database (Phase 3) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_workspace
DB_ECHO=false

# --- Auth (Phase 4) ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM (Phase 6) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# --- Embeddings / RAG (Phase 9-10) ---
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Web Search (Phase 12-13) ---
WEB_SEARCH_API_KEY=

# --- Redis (Phase 16) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# --- Langfuse (Phase 17) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- SaaS Plans (Phase 15) ---
FREE_PLAN_DAILY_MESSAGE_LIMIT=20
PRO_PLAN_DAILY_MESSAGE_LIMIT=500

# --- Logging ---
LOG_LEVEL=INFO
