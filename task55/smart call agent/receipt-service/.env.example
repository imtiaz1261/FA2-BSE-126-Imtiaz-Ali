# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file, and never hardcode credentials in source.

PORT=9000
DATABASE_URL=postgresql://receipt_service_user:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/appointments

S3_BUCKET=citizen-services-receipts
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9001   # uncomment + set for MinIO/on-prem S3-compatible storage
S3_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_KEY

SIGNED_URL_TTL_SECONDS=86400

BOOKING_SERVICE_BASE_URL=http://localhost:7000
SERVICE_CATALOG_BASE_URL=http://localhost:5000
TRACKING_SERVICE_BASE_URL=http://localhost:8500
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8000

ORG_NAME=Citizen Services Department
