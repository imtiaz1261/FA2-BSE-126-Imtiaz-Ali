# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file.

PORT=4000

STT_PROVIDER=deepgram
STT_API_KEY=REPLACE_WITH_YOUR_STT_API_KEY

TTS_PROVIDER=azure
TTS_API_KEY=REPLACE_WITH_YOUR_TTS_API_KEY
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_UR=ur-PK-UzmaNeural

ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
DIALOGUE_MODEL=claude-sonnet-4-6

SLOT_ENGINE_BASE_URL=http://localhost:6000
BOOKING_SERVICE_BASE_URL=http://localhost:7000
