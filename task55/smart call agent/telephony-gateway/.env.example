# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file.

PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=REPLACE_WITH_YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_AUTH_TOKEN
TWILIO_SERVICE_NUMBER=+9231XXXXXXX

# This service's own publicly reachable URL (use your ngrok URL in dev)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok.io

# Where Twilio's Media Stream should connect
MEDIA_STREAM_WSS_URL=wss://your-ngrok-subdomain.ngrok.io/media-stream

# voice-agent's WebSocket session endpoint
VOICE_AGENT_WS_URL=ws://localhost:4000/session

HUMAN_QUEUE_NAME=citizen-services-queue
REDIS_URL=redis://localhost:6379
