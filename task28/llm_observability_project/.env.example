# LLM Provider (Groq - OpenAI-compatible)
GROQ_API_KEY=paste key
MODEL_NAME=llama-3.1-8b-instant

# Optional: switch to OpenAI instead
OPENAI_API_KEY=no OPENAI_API_KEY

LLM_PROVIDER=groq

# Observability (Langfuse - free self-hosted or cloud)
LANGFUSE_SECRET_KEY=paste key
LANGFUSE_PUBLIC_KEY=paste key
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Database
DATABASE_URL=sqlite:///./data/metrics.db

# API
MAX_REQUEST_SIZE_KB=32
RATE_LIMIT_PER_MINUTE=60
