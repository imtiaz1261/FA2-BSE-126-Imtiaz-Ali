# Which provider to use: "groq" (free) or "openai" (paid)
LLM_PROVIDER=groq

# Get a FREE key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=enter api

# Only needed if you set LLM_PROVIDER=openai
OPENAI_API_KEY=noapi

# Model to use. Good free Groq defaults: llama-3.1-8b-instant, llama-3.1-70b-versatile
MODEL_NAME=llama-3.1-8b-instant
