# --- App ---
APP_NAME=AI Research Workspace
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings (Phase 9) ---
# If using Groq/local for LLM, set a real OpenAI key here for embeddings.
# Leave blank to reuse OPENAI_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- Database (Phase 3) ---
DATABASE_URL=postgresql+psycopg://postgres:imtiaz123@localhost:5432/ai_workspace

# --- Redis (Phase 16) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (Phase 4) ---
JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

